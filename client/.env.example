VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# The Python AI service (ai-service folder) needs no setting here: the website
# reaches it through its own /ai address, which the dev server forwards to
# http://127.0.0.1:8000 (see vite.config.js). On the live site, Cloudflare's
# AI_SERVICE_URL setting does this instead (see functions/ai).

# This computer's Wi-Fi address and the website's port, used inside the
# identity verification QR code (phones can't open "localhost").
# If you switch Wi-Fi networks (e.g. at the defense), update this line: run
# "ipconfig" and use the "IPv4 Address" under "Wireless LAN adapter Wi-Fi".
VITE_PUBLIC_APP_URL=https://192.168.1.5:5173
