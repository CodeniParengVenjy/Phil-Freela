VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# The website reaches the Python AI service (ai-service folder) through its own
# /ai address. The dev server forwards it to this address (see vite.config.js);
# leave it out to use the AI service running on this laptop
# (http://127.0.0.1:8000). On the live site, Cloudflare's AI_SERVICE_URL
# setting does the same job (see functions/ai).
AI_SERVICE_URL=https://your-ai-service.vercel.app

# This computer's Wi-Fi address and the website's port, used inside the
# identity verification QR code (phones can't open "localhost").
# If you switch Wi-Fi networks (e.g. at the defense), update this line: run
# "ipconfig" and use the "IPv4 Address" under "Wireless LAN adapter Wi-Fi".
VITE_PUBLIC_APP_URL=https://192.168.1.5:5173
