# Copy this file to .env and fill in the real values. .env is never committed.

SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase dashboard -> Project Settings -> API Keys -> "service_role" (secret).
# It has full access to the database, so it stays in this folder only:
# never put it in the website (client folder) or share it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Website addresses allowed to call this service straight from a browser,
# separated by commas. The website normally goes through its own /ai address
# instead, so this rarely matters.
ALLOWED_ORIGINS=http://localhost:5173,https://localhost:5173
